[Unit]
Description=Astropath agent workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astropath
Group=astropath
WorkingDirectory=/app/astropath/current
EnvironmentFile=/app/astropath/shared/app.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=__PORT__
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=__NODE__ /app/astropath/current/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=65
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/app/astropath/current/.next/cache
MemoryMax=768M

[Install]
WantedBy=multi-user.target
