# Local development origin. Production: your stable HTTPS origin, without a path.
APP_URL=http://localhost:3000
# Generate once per instance: openssl rand -base64 32
# Keep this stable; changing it affects sessions and encrypted OAuth signing keys.
BETTER_AUTH_SECRET=
# Server-held content encryption key. Generate separately with openssl rand -base64 32.
# Keep stable and back up separately from Postgres and object storage. Never commit it.
ASTROPATH_MASTER_KEY=
# Postgres URL, including SSL options from your provider.
# Use a pooled URL for the app; a direct URL for migrations/bootstrap.
DATABASE_URL=
# Choose r2 for Cloudflare R2 or vercel for Vercel Blob (default).
STORAGE_PROVIDER=vercel
# Required only for Vercel Blob, or temporarily as a migration read fallback.
BLOB_READ_WRITE_TOKEN=
# Required when STORAGE_PROVIDER=r2. Keep the bucket PRIVATE.
# Use Object Read & Write credentials restricted to this bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
# Optional prefix for isolating development objects in a shared bucket.
R2_KEY_PREFIX=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional, separate PUBLIC bucket for files anyone can download directly.
# All five are required. Never point this at the private bucket above.
# Create a separate Object Read & Write token scoped to the public bucket.
R2_PUBLIC_ACCOUNT_ID=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
# Platform administrator. Content access still requires tenant membership.
# Tenant owners invite members; each connection belongs to one tenant.
OWNER_EMAIL=
# Optional display name, used only when creating the owner (default: Owner).
OWNER_NAME=
# At least 12 characters. Only used by owner:create; remove after initialization.
# Do not add OWNER_PASSWORD to the Vercel project environment.
OWNER_PASSWORD=
# Optional: the Projects overview. An OpenAI Responses API base, e.g. aigateway on the
# same host: http://127.0.0.1:4340/chatgpt/v1. Each workspace owner must still
# opt in. Not a secret.
ASTROPATH_AI_BASE_URL=
# Model for the Projects overview (default gpt-5.6-sol).
ASTROPATH_PROJECTS_MODEL=
